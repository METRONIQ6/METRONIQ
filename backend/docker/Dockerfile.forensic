FROM python:3.10-slim-bullseye

RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    wget \
    libgomp1 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY docker/requirements-forensic.txt ./
RUN pip install --no-cache-dir -r requirements-forensic.txt --extra-index-url https://download.pytorch.org/whl/cpu

COPY app/ai ./ai
