# METRONIQ BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (mandatory — SQLite is NOT supported in production)
DATABASE_URL=postgresql://user:password@host:5432/metroniq

# Google Gemini API key (required for Copilot and declaration extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_randomly_generated_string_here

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# URL of the external PaddleOCR microservice (ocr_service/)
# If unset, backend falls back to local PaddleOCR installation (requires paddleocr package)
# OCR_SERVICE_URL=https://your-codespace-url-7860.app.github.dev

# Comma-separated list of allowed CORS origins
# CORS_ORIGINS=https://metroniq.vercel.app,http://localhost:3000

# Deployment environment (development | production)
# ENVIRONMENT=production
