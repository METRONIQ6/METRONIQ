# METRONIQ BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# PostgreSQL connection string 
# (You can use your remote NeonDB or local postgresql instance)
DATABASE_URL="postgresql://user:password@host/dbname"

# Google Gemini API key 
GEMINI_API_KEY="your_gemini_api_key_here"

# JWT signing secret
SECRET_KEY="your_secure_randomly_generated_string_here"

# CORS
# CORS_ORIGINS="https://metroniq.vercel.app,http://localhost:3000"
