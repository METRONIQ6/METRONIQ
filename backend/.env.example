# METRONIQ REQUIRED ENVIRONMENT VARIABLES
# -------------------------------------
# For SIH Evaluators/Judges:
# The system relies on Google's Gemini Pro for extracting compliance declarations from packaging (OCR).
# You must provide a valid API key below for the AI scanner to function.

GEMINI_API_KEY=your_gemini_api_key_here 

# OPTIONAL CONFIGURATIONS:
# -------------------------------------
# The system natively uses SQLite (metroniq-dev.db) for zero-configuration testing.
# If you wish to use PostgreSQL, uncomment and swap the URL below:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/metroniq
